{
  "name": "wattpad-okuma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:standalone",
    "build:standalone": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/static",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/scripts/seed.ts",
    "import:account": "tsx src/scripts/import-account.ts",
    "import:wait": "tsx src/scripts/wait-and-import.ts",
    "import:stories": "tsx src/scripts/import-stories.ts",
    "import:ydys": "tsx src/scripts/import-ydys.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.2",
    "epub2": "^3.0.2",
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "next": "^15.3.3",
    "pdfkit": "^0.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/sanitize-html": "^2.16.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
